# ==============================================================================
# 🏛️ GupShupp Enterprise Pro: Production Environment Variables Template
# Map these values into GitHub Repository Secrets (Settings -> Secrets -> Actions)
# ==============================================================================

# Server Network Port
PORT=3000

# Node Environment
NODE_ENV=production

# Multi-Worker Cluster Mode (Set 'true' for Oracle Cloud 3 OCPUs)
CLUSTER_MODE=true

# MongoDB Connection URI (Atlas / Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/gupshupp?retryWrites=true&w=majority

# Google Gemini 2.5 AI Brain API Key
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here

# Ultra-Secure JWT Secret Salt Keys (Generated automatically or custom)
JWT_SECRET=gupshupp_ultra_secure_jwt_secret_2026_enterprise_production
JWT_REFRESH_SECRET=gupshupp_jwt_refresh_secure_secret_key_2026_enterprise_production
